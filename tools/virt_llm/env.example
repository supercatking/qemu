# Source this file or export equivalent variables before running virt-llm helpers.
# Defaults assume the historical local layout, but every path can be overridden.

export QEMU_SRC=${QEMU_SRC:-/home/qemu/qemu}
export QEMU_BUILD=${QEMU_BUILD:-$QEMU_SRC/build}
export QEMU_BIN=${QEMU_BIN:-$QEMU_BUILD/qemu-system-riscv32}

export LINUX_SRC=${LINUX_SRC:-/home/qemu/linux-6.12}
export LINUX_BUILD=${LINUX_BUILD:-/home/qemu/linux-6.12-build-rv32}
export LINUX_IMAGE=${LINUX_IMAGE:-$LINUX_BUILD/arch/riscv/boot/Image}

export CROSS_COMPILE=${CROSS_COMPILE:-riscv64-linux-gnu-}
export VIRT_LLM_MODEL_PATH=${VIRT_LLM_MODEL_PATH:-/home/zyz/llmsim/models/qwen2.5-0.5b-instruct/model.safetensors}
export VIRT_LLM_ARTIFACT_DIR=${VIRT_LLM_ARTIFACT_DIR:-$QEMU_BUILD/virt-llm-artifacts}
export VIRT_LLM_LOG_DIR=${VIRT_LLM_LOG_DIR:-$VIRT_LLM_ARTIFACT_DIR/logs}
